# Configuration gratuite du flux "mot de passe oublié".
# Exemple Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Serveur ---
# Port d'écoute de l'API (49300 par défaut). Derrière Caddy, le port reste interne.
PORT=49300

# --- Base de données ---
# "sqlite" (défaut, une base par église) ou "mysql".
DB_MODE=sqlite
# Dossier des bases SQLite, des photos, des médias de galerie et des sauvegardes.
# À placer HORS du dossier de code pour survivre aux déploiements.
# Windows : C:\base-communaute  |  Linux : /var/lib/ma-communaute
SQLITE_DB_DIR=
# Uniquement si DB_MODE=mysql :
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Authentification de l'API ---
# Obligatoire sur un serveur partagé. Sans valeur, le secret est dérivé de la référence
# locale : acceptable sur un poste, pas en ligne.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Abonnement en ligne (SasPay) ---
# "true" seulement sur le service en ligne : une église qui paie son abonnement.
# Sur un poste local, laisser "false" — c'est la licence desktop qui règle l'accès.
ABONNEMENT_REQUIS=false
# Montants en XOF. SasPay refuse toute session sous 200 XOF.
ABONNEMENT_PRIX_MENSUEL=5000
ABONNEMENT_PRIX_ANNUEL=50000
# Page vers laquelle SasPay renvoie le client après un paiement réussi.
ABONNEMENT_URL_RETOUR=
# Clé secrète du tableau de bord SasPay : sk_test_... en test, sk_live_... en production.
# Elle donne accès aux retraits : jamais dans le front, jamais dans un dépôt.
SASPAY_API_KEY=
# Secret de signature du webhook, fourni avec l'URL de notification dans le tableau de bord.
SASPAY_WEBHOOK_SECRET=
SASPAY_BASE_URL=https://api.saspay.me/api/v1

# --- Licence desktop ---
# Laisser vide ou "true" sur un poste client : le blocage fonctionne normalement
# (essai de DESKTOP_TRIAL_DAYS jours, codes de déblocage, rattachement machine).
# Mettre "false" UNIQUEMENT sur un serveur partagé : l'état de la licence reste
# consultable dans Paramètres, mais il ne ferme plus l'accès à personne.
DESKTOP_LICENSE_ENFORCED=true
# Durée de l'essai à la création de la licence locale (15 jours par défaut).
DESKTOP_TRIAL_DAYS=15
